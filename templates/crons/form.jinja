<div class="page-header d-print-none mb-3">
  <div class="row g-2 align-items-center">
    <div class="col">
      <div class="page-pretitle">Crons</div>
      <h2 class="page-title">{{title}}</h2>
    </div>
  </div>
</div>

<form method="post" action="{{action}}">
  <input type="hidden" name="_csrf_token" value="{{_csrf_token}}" />

  <div class="row row-cards">
    <div class="col-lg-5">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">Job</h3>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <label class="form-label required">Server</label>
            <select class="form-select" required name="server_id">
              {% for server in servers %}
              <option value="{{server.ID}}" {% if server._id == server_id %}selected{% endif %}>
                {{server.ServerName}}
              </option>
              {% endfor %}
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label required">Cron name</label>
            <input class="form-control" required name="cron_name" value="{{ cron_name }}"
              placeholder="Clear application cache" />
          </div>

          <div class="mb-3">
            <label class="form-label required">Cron user</label>
            <input type="text" class="form-control" required name="user" value="{{ user }}"
              placeholder="The Linux user to run the cron as" />
          </div>

          <div>
            <label class="form-label required">Cron command</label>
            <input type="text" required class="form-control font-monospace" name="task" value="{{ task }}"
              placeholder="php /var/www/mysite/artisan cache:clear" />
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-7">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title"><i class="ti ti-clock me-2"></i>Schedule</h3>
        </div>
        <div class="card-body">
          <pre class="mb-3"><code>.---------------- minute (0 - 59)
|  .------------- hour (0 - 23)
|  |  .---------- day of month (1 - 31)
|  |  |  .------- month (1 - 12) OR jan,feb,mar,apr ...
|  |  |  |  .---- day of week (0 - 6) (Sunday=0 or 7) OR sun,mon ...
|  |  |  |  |
*  *  *  *  *</code></pre>

          <div class="row g-2 mb-3">
            <div class="col">
              <label for="minute" class="form-label">Minute</label>
              <input type="text" id="minute" value="*" class="form-control timeinput text-center" placeholder="*">
            </div>
            <div class="col">
              <label for="hour" class="form-label">Hour</label>
              <input type="text" id="hour" value="*" class="form-control timeinput text-center" placeholder="*">
            </div>
            <div class="col">
              <label for="day" class="form-label">Day of month</label>
              <input type="text" id="day" value="*" class="form-control timeinput text-center" placeholder="*">
            </div>
            <div class="col">
              <label for="month" class="form-label">Month</label>
              <input type="text" id="month" value="*" class="form-control timeinput text-center" placeholder="*">
            </div>
            <div class="col">
              <label for="dayOfWeek" class="form-label">Day of week</label>
              <input type="text" id="dayOfWeek" value="*" class="form-control timeinput text-center" placeholder="*">
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label">Cron expression</label>
            <input type="text" name="cron_expression" class="form-control font-monospace fw-bold"
              id="cron-expression" placeholder="* * * * *" />
            <small class="form-hint">
              You can also type the expression directly, including constants such as
              <code>@hourly</code> or <code>@weekly</code>.
            </small>
          </div>

          <div>
            <label class="form-label">In plain English</label>
            <input type="text" readonly class="form-control" id="human-readable" value="Every minute"
              placeholder="Every minute" />
          </div>
        </div>

        <div class="card-footer text-end">
          <button type="submit" class="btn btn-primary">Save cron</button>
        </div>
      </div>
    </div>
  </div>
</form>

<script src="/static/js/cronstrue/cronstrue.min.js"></script>


  <script>
      function updateCronExpression() {
          const minute = document.getElementById('minute').value.trim();
          const hour = document.getElementById('hour').value.trim();
          const day = document.getElementById('day').value.trim();
          const month = document.getElementById('month').value.trim();
          const dayOfWeek = document.getElementById('dayOfWeek').value.trim();
          const cronExpression = `${minute} ${hour} ${day} ${month} ${dayOfWeek}`;
          document.getElementById('cron-expression').value = cronExpression;


          humanReadableControl = document.getElementById('human-readable');
          try {
              const humanReadable = cronstrue.toString(cronExpression, {
                  throwExceptionOnParseError: true,
                  verbose: true
              });
              humanReadableControl.classList.remove("is-invalid");
              humanReadableControl.classList.add("is-valid");
              humanReadableControl.value = humanReadable;
          } catch (error) {
              humanReadableControl.value = "Invalid expression: " + cronExpression;
              humanReadableControl.classList.remove("is-valid");
              humanReadableControl.classList.add("is-invalid");
          }

      }

      function handleCronExpressionInput() {
          const cronExpressionInput = document.getElementById('cron-expression').value.trim();

          // Check if the user entered a cron constant or a specific cron expression
          if (cronExpressionInput.startsWith('@')) {
              handleCronConstant(cronExpressionInput);
              return; // Skip further processing since the input is a constant
          }

          // The user entered a specific cron expression
          populateFieldsFromCronExpression(cronExpressionInput);
          updateCronExpression();
      }

      // Function to check if the cron expression is a constant
      function cronIsConstant(minute, hour, day, month, dayOfWeek) {
          return (minute.startsWith('@') || hour.startsWith('@') || day.startsWith('@') || month.startsWith('@') ||
              dayOfWeek.startsWith('@'));
      }

      // Function to handle cron constants
      function handleCronConstant(cronExpressionInput) {
          const cronConstants = {
              '@hourly': '0 * * * *',
              '@daily': '0 0 * * *',
              '@weekly': '0 0 * * 0',
              '@monthly': '0 0 1 * *'
              // Add more constants as needed
          };

          const cronExpression = cronConstants[cronExpressionInput];
          if (cronExpression) {
              populateFieldsFromCronExpression(cronExpression);
              updateCronExpression();
          }
      }

      // Function to populate fields from a cron expression
      function populateFieldsFromCronExpression(cronExpression) {
          const fields = cronExpression.split(' ');
          document.getElementById('minute').value = fields[0];
          document.getElementById('hour').value = fields[1];
          document.getElementById('day').value = fields[2];
          document.getElementById('month').value = fields[3];
          document.getElementById('dayOfWeek').value = fields[4];
      }

      // Attach event listeners to input fields to update cron expression
      const inputFields = document.querySelectorAll('input.form-control.timeinput');
      inputFields.forEach((input) => {
          input.addEventListener('input', updateCronExpression);
      });

      // Attach event listener to "cron-expression" input field
      document.getElementById('cron-expression').addEventListener('input', handleCronExpressionInput);

      // Initial update
      populateFieldsFromCronExpression('{{cron_expression}}')
      updateCronExpression();
  </script>

