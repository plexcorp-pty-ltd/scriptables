<div class="page-header d-print-none mb-3">
  <div class="row g-2 align-items-center">
    <div class="col">
      <h2 class="page-title">Cron jobs</h2>
      <div class="text-secondary mt-1">{{numCrons}} cron job(s)</div>
    </div>
    <div class="col-auto ms-auto d-print-none">
      <a href="/cron/create" class="btn btn-primary">
        <i class="ti ti-plus me-2"></i>Add cron
      </a>
    </div>
  </div>
</div>

{% if numCrons == 0 %}
<div class="card">
  <div class="empty">
    <div class="empty-icon">
      <i class="ti ti-robot text-secondary" style="font-size:3rem"></i>
    </div>
    <p class="empty-title">No cron jobs found</p>
    <p class="empty-subtitle text-secondary">
      Schedule your first job on one of your servers.
    </p>
    <div class="empty-action">
      <a href="/cron/create" class="btn btn-primary">
        <i class="ti ti-plus me-2"></i>Add a cron
      </a>
    </div>
  </div>
</div>
{% else %}
<div class="card">
  <div class="card-body border-bottom py-3">
    <form method="get" action="/crons">
      <div class="input-group" style="max-width:380px">
        <input type="text" name="search" placeholder="Search crons&hellip;" value="{{search}}" class="form-control" />
        <button type="submit" class="btn">
          <i class="ti ti-search"></i>
        </button>
      </div>
    </form>
  </div>

  <div class="table-responsive">
    <table class="table table-vcenter card-table">
      <thead>
        <tr>
          <th>Cron name</th>
          <th>Server</th>
          <th>Status</th>
          <th>User</th>
          <th>Expression</th>
          <th>Updated</th>
          <th class="w-1">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for cron in crons %}
        <tr>
          <td>{{cron.CronName}}</td>
          <td class="text-secondary">{{cron.ServerName}}</td>
          <td>
            {% if cron.Status == STATUS_QUEUED %}
            <span class="badge bg-secondary-lt">Queued</span>
            {% endif %}
            {% if cron.Status == STATUS_CONNECTING %}
            <span class="badge bg-azure-lt">Connecting</span>
            {% endif %}
            {% if cron.Status == STATUS_COMPLETE %}
            <span class="badge bg-success-lt">Active</span>
            {% endif %}
            {% if cron.Status == STATUS_RUNNING %}
            <span class="badge bg-blue-lt">Building</span>
            {% endif %}
            {% if cron.Status == STATUS_FAILED %}
            <span class="badge bg-danger-lt">Failed</span>
            {% endif %}
          </td>
          <td class="text-secondary">{{cron.User}}</td>
          <td class="text-secondary font-monospace">{{cron.CronExpression}}</td>
          <td class="text-secondary">{{cron.UpdatedAt}}</td>
          <td>
            <div class="btn-list flex-nowrap">
              <a href="/cron/edit/{{cron.ID}}" class="btn btn-icon btn-sm" title="Edit cron" data-bs-toggle="tooltip">
                <i class="ti ti-edit"></i>
              </a>

              <a href="/logs/cron/{{cron.ID}}" class="btn btn-icon btn-sm" title="View log" data-bs-toggle="tooltip">
                <i class="ti ti-terminal-2"></i>
              </a>

              {% if cron.Status == STATUS_COMPLETE %}
              <form method="post" action="/cron/disable" id="form-{{cron.ID}}">
                <input type="hidden" name="_csrf_token" value="{{_csrf_token}}" />
                <input type="hidden" name="id" value="{{cron.ID}}" />
                <button type="submit" class="btn btn-icon btn-sm btn-ghost-danger" title="Disable cron"
                  data-bs-toggle="tooltip">
                  <i class="ti ti-ban"></i>
                </button>
              </form>
              {% endif %}

              {% if cron.Status == STATUS_FAILED %}
              <form method="post" action="/cron/retrybuild">
                <input type="hidden" name="_csrf_token" value="{{_csrf_token}}" />
                <input type="hidden" name="retryBuildId" value="{{cron.ID}}" />
                <button type="submit" class="btn btn-icon btn-sm" title="Retry deploying cron"
                  data-bs-toggle="tooltip">
                  <i class="ti ti-reload"></i>
                </button>
              </form>
              {% endif %}
            </div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endif %}
