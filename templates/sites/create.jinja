<div class="page-header d-print-none mb-3">
  <div class="row g-2 align-items-center">
    <div class="col">
      <div class="page-pretitle">Sites</div>
      <h2 class="page-title">Set up a new site</h2>
    </div>
  </div>
</div>

<form method="post" action="/site/save/">
  <input type="hidden" name="_csrf_token" value="{{_csrf_token}}" />

  <div class="row row-cards">
    <div class="col-lg-7">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">Site</h3>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <label class="form-label required">Domain name</label>
            <input class="form-control" required name="domain" value="{{domain}}" placeholder="example.com" />
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label required">Server</label>
              <select class="form-select" required name="server_id">
                {% for server in servers %}
                <option value="{{server.ID}}" {% if server._id == server_id %}selected{% endif %}>
                  {{server.ServerName}}
                </option>
                {% endfor %}
              </select>
            </div>

            <div class="col-md-6 mb-3">
              <label class="form-label required">Site type</label>
              <select name="scriptables" class="form-select" required>
                <option value="laravel" selected>Laravel</option>
              </select>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label required">Webroot</label>
            <input class="form-control" required name="webroot" value="{{webroot}}" placeholder="public" />
            <small class="form-hint">
              Where your <code>index.php</code> lives, relative to the project root.
            </small>
          </div>

          <div class="row">
            <div class="col-md-8 mb-3">
              <label class="form-label required">Git URL</label>
              <input class="form-control" required name="git_url" value="{{git_url}}"
                placeholder="git@github.com:you/app.git" />
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label required">Git branch</label>
              <input class="form-control" required name="branch" value="{{branch}}" placeholder="main" />
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label required">PHP version</label>
              <select class="form-select" required name="php_version">
                <option value="8.5" {% if php_version == "8.5" %}selected{% endif %}>8.5</option>
                <option value="8.4" {% if php_version == "8.4" %}selected{% endif %}>8.4</option>
                <option value="8.3" {% if php_version == "8.3" %}selected{% endif %}>8.3</option>
              </select>
            </div>

            <div class="col-md-6 mb-3">
              <label class="form-label">HTTPS</label>
              <label class="form-check form-switch mt-2">
                <input class="form-check-input" type="checkbox" name="letsencrypt_certificate" {% if
                  LetsEncryptCertificate == 1 %}checked{% endif %} />
                <span class="form-check-label">Set up a Let's Encrypt certificate</span>
              </label>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="card mb-3">
        <div class="card-header">
          <h3 class="card-title">Database</h3>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <label class="form-label">
              MySQL password
              <span class="form-label-description">
                <a href="#" class="link-secondary" onclick="togglePasswordVisibility('mysql_password', event)">
                  <i class="ti ti-eye"></i>
                </a>
              </span>
            </label>
            <input type="password" class="form-control" id="mysql_password" name="mysql_password"
              value="{{mysql_password}}" />
          </div>

          <div>
            <label class="form-label">
              Confirm MySQL password
              <span class="form-label-description">
                <a href="#" class="link-secondary" onclick="togglePasswordVisibility('mysql_password_confirm', event)">
                  <i class="ti ti-eye"></i>
                </a>
              </span>
            </label>
            <input type="password" class="form-control" id="mysql_password_confirm" name="mysql_password_confirm"
              value="{{mysql_password_confirm}}" />
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <h3 class="card-title">Environment</h3>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <label class="form-label required">
              Config file
              <span class="form-help" data-bs-toggle="tooltip" title="The .env file to use when setting up your site.">?</span>
            </label>
            <input type="text" value="{{environment}}" class="form-control"
              placeholder="prod.env, dev.env, staging.env" name="environment" />
          </div>

          <p class="text-secondary mb-2">
            <strong>Note:</strong> use these placeholders in your env file so Scriptables can inject the
            database settings.
          </p>
          <pre class="mb-0"><code>DB_DATABASE=PLEX_MYSQL_DB
DB_USERNAME=PLEX_MYSQL_USERNAME
DB_PASSWORD="PLEX_MYSQL_PASSWORD"</code></pre>
        </div>

        <div class="card-footer">
          <button type="submit" class="btn btn-primary w-100">
            Next<i class="ti ti-arrow-right ms-2"></i>
          </button>
        </div>
      </div>
    </div>
  </div>
</form>

<script>
  function togglePasswordVisibility(name, event) {
    event.preventDefault();
    var passwordInput = document.getElementById(name);
    passwordInput.type = passwordInput.type === "password" ? "text" : "password";
  }
</script>
