{# Deploy key fragment swapped in by htmx once the key has been generated on the
   target server. #}
{% if errorMsg is defined %}
<div class="alert alert-danger mb-0" role="alert">
  <div class="d-flex">
    <div class="me-3"><i class="ti ti-alert-circle icon alert-icon"></i></div>
    <div>
      <h4 class="alert-title">Could not generate a deploy key</h4>
      <div class="text-secondary">{{ errorMsg }}</div>
    </div>
  </div>
</div>

<div class="mt-3">
  <button class="btn" hx-post="/site/generateDeployKey" hx-vals='{"siteId": "{{ siteId }}"}'
    hx-target="#deploykey-result" hx-swap="innerHTML" hx-indicator="#deploykey-progress">
    <i class="ti ti-reload me-2"></i>Try again
  </button>
</div>
{% else %}
<p class="text-secondary">
  Copy this key into the deploy keys section of your GitHub, Bitbucket or GitLab repository settings.
</p>

<textarea class="form-control font-monospace" rows="5" readonly onclick="this.select()">{{ publicKey }}</textarea>

<form method="post" action="/site/confirm-deploy" class="mt-3">
  <input type="hidden" name="_csrf_token" value="{{ _csrf_token }}" />
  <input type="hidden" name="siteId" value="{{ siteId }}" />
  <button type="submit" class="btn btn-primary w-100">
    <i class="ti ti-check me-2"></i>I have finished the Git setup, continue with the deploy
  </button>
</form>
{% endif %}
