<div class="page-header d-print-none mb-3">
  <div class="row g-2 align-items-center">
    <div class="col">
      <div class="page-pretitle">Sites</div>
      <h2 class="page-title">{{title}}</h2>
    </div>
  </div>
</div>

<div class="row justify-content-center">
  <div class="col-lg-9">
    <div class="card mb-3">
      <div class="card-header">
        <h3 class="card-title">
          <i class="ti ti-brand-git me-2"></i>Deploy key
        </h3>
      </div>
      <div class="card-body">
        {# Outside the swap target so the retry button can reuse it. #}
        <div id="deploykey-progress" class="htmx-indicator">
          <div class="progress progress-sm mb-2">
            <div class="progress-bar progress-bar-indeterminate"></div>
          </div>
          <p class="text-secondary">Generating a deploy key on the server&hellip;</p>
        </div>

        <div id="deploykey-result" hx-post="/site/generateDeployKey" hx-vals='{"siteId": "{{siteId}}"}'
          hx-trigger="load" hx-swap="innerHTML" hx-indicator="#deploykey-progress"></div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Push webhook</h3>
      </div>
      <div class="card-body">
        <p class="text-secondary">
          Add this URL to your repository webhook settings and enable <strong>push / merge events only</strong>.
        </p>
        <input type="text" class="form-control font-monospace" readonly onclick="this.select()"
          value="{{scriptable_base_url}}/webhooks/deploy/{{siteId}}/{{token}}" />
      </div>
    </div>
  </div>
</div>
