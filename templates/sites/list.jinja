<div class="page-header d-print-none mb-3">
  <div class="row g-2 align-items-center">
    <div class="col">
      <h2 class="page-title">Sites</h2>
      <div class="text-secondary mt-1">{{numSites}} site(s)</div>
    </div>
    <div class="col-auto ms-auto d-print-none">
      <div class="d-flex gap-2 align-items-center">
        <input type="hidden" name="view" value="{{view}}" />
        <div class="btn-group" role="group">
          <a href="/sites" class="btn btn-icon{% if view != "list" %} active{% endif %}" title="Grid view"
            data-bs-toggle="tooltip">
            <i class="ti ti-layout-grid"></i>
          </a>
          <a href="/sites?view=list" class="btn btn-icon{% if view == "list" %} active{% endif %}" title="List view"
            data-bs-toggle="tooltip">
            <i class="ti ti-list"></i>
          </a>
        </div>

        <select class="form-select w-auto" name="status" hx-get="/sites" hx-trigger="change"
          hx-target="#site-results" hx-select="#site-results" hx-swap="outerHTML" hx-push-url="true"
          hx-include="[name='view']">
          <option value="all" {% if status=="all" %}selected{% endif %}>All sites</option>
          <option value="{{STATUS_QUEUED}}" {% if status==STATUS_QUEUED %}selected{% endif %}>Queued builds</option>
          <option value="{{STATUS_RUNNING}}" {% if status==STATUS_RUNNING %}selected{% endif %}>Running builds</option>
          <option value="{{STATUS_COMPLETE}}" {% if status==STATUS_COMPLETE %}selected{% endif %}>Active sites</option>
          <option value="{{STATUS_FAILED}}" {% if status==STATUS_FAILED %}selected{% endif %}>Failed builds</option>
          <option value="{{STATUS_CONNECTING}}" {% if status==STATUS_CONNECTING %}selected{% endif %}>Generating deploy
            key</option>
        </select>

        <a href="/site/create" class="btn btn-primary">
          <i class="ti ti-plus me-2"></i>New site
        </a>
      </div>
    </div>
  </div>
</div>

<div id="site-results">
{% if numSites == 0 %}
<div class="card">
  <div class="empty">
    <div class="empty-icon">
      <i class="ti ti-world text-secondary" style="font-size:3rem"></i>
    </div>
    <p class="empty-title">No sites found</p>
    <p class="empty-subtitle text-secondary">
      Deploy your first site to one of your servers.
    </p>
    <div class="empty-action">
      <a href="/site/create" class="btn btn-primary">
        <i class="ti ti-plus me-2"></i>Create a site
      </a>
    </div>
  </div>
</div>
{% endif %}

{% if view == "list" and numSites > 0 %}
<div class="card">
  <div class="table-responsive">
    <table class="table table-vcenter card-table">
      <thead>
        <tr>
          <th>Site name</th>
          <th>Domain</th>
          <th>Server</th>
          <th>Git URL</th>
          <th>Branch</th>
          <th>Environment</th>
          <th>Status</th>
          <th>Scriptable</th>
          <th class="w-1">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for s in sites %}
        <tr>
          <td>{{s.SiteName}}</td>
          <td class="text-secondary">{{s.Domain}}</td>
          <td class="text-secondary">{{s.ServerName}}</td>
          <td class="text-secondary font-monospace">{{s.GitURL}}</td>
          <td class="text-secondary">{{s.Branch}}</td>
          <td class="text-secondary">{{s.Environment}}</td>
          <td>
            {% if s.Status == STATUS_QUEUED %}
            <span class="badge bg-secondary-lt">Queued</span>
            {% endif %}
            {% if s.Status == STATUS_CONNECTING %}
            <span class="badge bg-azure-lt">Deploy key</span>
            {% endif %}
            {% if s.Status == STATUS_COMPLETE %}
            <span class="badge bg-success-lt">Online</span>
            {% endif %}
            {% if s.Status == STATUS_RUNNING %}
            <span class="badge bg-blue-lt">Deploying</span>
            {% endif %}
            {% if s.Status == STATUS_FAILED %}
            <span class="badge bg-danger-lt">Failed</span>
            {% endif %}
          </td>
          <td class="text-secondary">{{s.ScriptableName}}</td>
          <td>
            <div class="btn-list flex-nowrap">
              <a href="/logs/site/{{s.ID}}" class="btn btn-icon btn-sm" title="View log" data-bs-toggle="tooltip">
                <i class="ti ti-terminal-2"></i>
              </a>

              {% if s.Status == STATUS_FAILED %}
              <form method="post" action="/site/retrybuild/">
                <input type="hidden" name="_csrf_token" value="{{_csrf_token}}" />
                <input type="hidden" name="siteId" value="{{s.ID}}" />
                <button type="submit" class="btn btn-icon btn-sm" title="Retry deploy" data-bs-toggle="tooltip">
                  <i class="ti ti-reload"></i>
                </button>
              </form>
              {% endif %}

              {% if s.Status == STATUS_COMPLETE %}
              <form method="post" action="/site/deploy/">
                <input type="hidden" name="_csrf_token" value="{{_csrf_token}}" />
                <input type="hidden" name="siteId" value="{{s.ID}}" />
                <button type="submit" class="btn btn-icon btn-sm" title="Deploy site" data-bs-toggle="tooltip">
                  <i class="ti ti-rocket"></i>
                </button>
              </form>
              <a href="/systemd/services/{{s.ID}}/list" class="btn btn-icon btn-sm" title="Queue workers"
                data-bs-toggle="tooltip">
                <i class="ti ti-player-play"></i>
              </a>
              {% endif %}
            </div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

{% else %}

<div class="row row-cards">
  {% for s in sites %}
  <div class="col-md-6 col-xl-4">
    <div class="card h-100">
      <div class="card-body">
        <div class="d-flex align-items-start">
          <div class="flex-fill">
            <h3 class="card-title mb-1">{{s.SiteName}}</h3>
            <div class="text-secondary small">{{s.Domain}} &middot; {{s.ServerName}}</div>
            <div class="mt-2">
              {% if s.Status == STATUS_QUEUED %}
              <span class="badge bg-secondary-lt">Deploy queued</span>
              {% endif %}
              {% if s.Status == STATUS_CONNECTING %}
              <span class="badge bg-azure-lt">Generating deploy key</span>
              {% endif %}
              {% if s.Status == STATUS_COMPLETE %}
              <span class="badge bg-success-lt">Online</span>
              {% endif %}
              {% if s.Status == STATUS_RUNNING %}
              <span class="badge bg-blue-lt">Deploying</span>
              {% endif %}
              {% if s.Status == STATUS_FAILED %}
              <span class="badge bg-danger-lt">Deploy failed</span>
              {% endif %}
            </div>
          </div>
          <img src="/static/icons/php.svg" alt="php" style="max-width:56px" class="ms-3" />
        </div>

        <div class="mt-3">
          <label class="form-label">Git deploy webhook</label>
          <input type="text" class="form-control form-control-sm font-monospace" readonly
            onclick="this.select()" value="{{scriptable_base_url}}/webhooks/deploy/{{s.ID}}/{{s.DeployToken}}" />
        </div>
      </div>

      <div class="card-footer">
        <div class="btn-list">
          <a href="/logs/site/{{s.ID}}" class="btn btn-sm">
            <i class="ti ti-terminal-2 me-1"></i>Log
          </a>

          {% if s.Status == STATUS_FAILED %}
          <form method="post" action="/site/retrybuild/">
            <input type="hidden" name="_csrf_token" value="{{_csrf_token}}" />
            <input type="hidden" name="siteId" value="{{s.ID}}" />
            <button type="submit" class="btn btn-sm">
              <i class="ti ti-reload me-1"></i>Retry
            </button>
          </form>
          {% endif %}

          {% if s.Status == STATUS_COMPLETE %}
          <form method="post" action="/site/deploy/">
            <input type="hidden" name="_csrf_token" value="{{_csrf_token}}" />
            <input type="hidden" name="siteId" value="{{s.ID}}" />
            <button type="submit" class="btn btn-sm">
              <i class="ti ti-rocket me-1"></i>Deploy
            </button>
          </form>
          <a href="/systemd/services/{{s.ID}}/list" class="btn btn-sm">
            <i class="ti ti-player-play me-1"></i>Workers
          </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
  {% endfor %}
</div>
{% endif %}

</div>
