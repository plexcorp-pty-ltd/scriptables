<div class="page-header d-print-none mb-3">
  <h2 class="page-title">My profile</h2>
</div>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <form class="card" method="POST" action="/user/profile/update">
      <input type="hidden" name="_csrf_token" value="{{_csrf_token}}" />

      <div class="card-body">
        <div class="mb-3">
          <label class="form-label">Name</label>
          <input type="text" id="name" name="name" value="{{user.Name}}" class="form-control" />
        </div>

        <div class="mb-3">
          <label class="form-label">Email address</label>
          <input type="email" id="email" name="email" value="{{user.Email}}" class="form-control" />
        </div>

        <div class="mb-3">
          <label class="form-check form-switch">
            <input class="form-check-input" type="checkbox" name="two_factor" id="two_factor" {% if user.TwoFactor == 1
              %} checked {% endif %} onclick="handleCheckboxChange()" />
            <span class="form-check-label">Enable two factor authentication</span>
          </label>

          <div id="qrcode" class="mt-3" style="display:none;">
            <img src="/static/img/loader.gif" id="loading-icon" alt="QR code" class="img-fluid"
              style="max-width:220px" />
            <p class="text-secondary mt-2 mb-0">
              Scan this QR code with your Google Authenticator app, then hit save below.
            </p>
          </div>
        </div>
      </div>

      <div class="card-footer text-end">
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div>
</div>

<script>
  function handleCheckboxChange() {
    var checkbox = document.getElementById("two_factor");
    var qrcodeDiv = document.getElementById("qrcode");

    if (checkbox.checked) {
      qrcodeDiv.style.display = "block";
      document.getElementById("loading-icon").src = "/user/2factor/qrcode";
    } else {
      qrcodeDiv.style.display = "none";
    }
  }
</script>
