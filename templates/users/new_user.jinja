<div class="page-header d-print-none mb-3">
  <h2 class="page-title">Add new user</h2>
</div>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <form class="card" method="post" action="/user/actions">
      <input type="hidden" name="action" value="newuser" />
      <input type="hidden" name="user_id" value="0" />
      <input type="hidden" name="_csrf_token" value="{{_csrf_token}}" />

      <div class="card-body">
        <div class="mb-3">
          <label class="form-label required">Full name</label>
          <input class="form-control" name="name" placeholder="Jane Doe" required />
        </div>

        <div class="mb-3">
          <label class="form-label required">Email address</label>
          <input class="form-control" name="email" type="email" placeholder="jane@example.com" required />
          <small class="form-hint">We will email an invite with a link to set a password.</small>
        </div>
      </div>

      <div class="card-footer text-end">
        <div class="d-flex">
          <a href="/user/list" class="btn btn-link">Cancel</a>
          <button type="submit" class="btn btn-primary ms-auto">Invite user</button>
        </div>
      </div>
    </form>
  </div>
</div>
