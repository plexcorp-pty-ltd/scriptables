<div class="page-header d-print-none mb-3">
  <div class="row g-2 align-items-center">
    <div class="col">
      <div class="page-pretitle">Sites</div>
      <h2 class="page-title">{{title}}</h2>
    </div>
    <div class="col-auto ms-auto d-print-none">
      <a href="/systemd/services/create" class="btn btn-primary">
        <i class="ti ti-plus me-2"></i>Add queue worker
      </a>
    </div>
  </div>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-vcenter card-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Status</th>
          <th>Scriptable</th>
          <th>Command</th>
          <th>Updated</th>
          <th class="w-1">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for s in services %}
        <tr>
          <td>{{s.Name}}</td>
          <td>
            {% if s.Status == STATUS_QUEUED %}
            <span class="badge bg-secondary-lt">Queued</span>
            {% endif %}
            {% if s.Status == STATUS_COMPLETE %}
            <span class="badge bg-success-lt">Running</span>
            {% endif %}
            {% if s.Status == STATUS_RUNNING %}
            <span class="badge bg-blue-lt">Building</span>
            {% endif %}
            {% if s.Status == STATUS_FAILED %}
            <span class="badge bg-danger-lt">Failed</span>
            {% endif %}
          </td>
          <td class="text-secondary">{{s.Scriptable}}</td>
          <td class="text-secondary font-monospace">{{s.Command}}</td>
          <td class="text-secondary">{{s.UpdatedAt}}</td>
          <td>
            <div class="btn-list flex-nowrap">
              <a href="/systemd/services/{{s.ID}}" class="btn btn-icon btn-sm" title="Edit worker"
                data-bs-toggle="tooltip">
                <i class="ti ti-edit"></i>
              </a>

              {% if s.Status == STATUS_COMPLETE %}
              <form method="post" action="/systemd/services/disable" id="form-{{s.ID}}">
                <input type="hidden" name="_csrf_token" value="{{_csrf_token}}" />
                <input type="hidden" name="id" value="{{s.ID}}" />
                <button type="submit" class="btn btn-icon btn-sm btn-ghost-danger" title="Disable worker"
                  data-bs-toggle="tooltip">
                  <i class="ti ti-ban"></i>
                </button>
              </form>
              {% endif %}

              {% if s.Status == STATUS_FAILED %}
              <form method="post" action="/systemd/services/retry">
                <input type="hidden" name="_csrf_token" value="{{_csrf_token}}" />
                <input type="hidden" name="retryBuildId" value="{{s.ID}}" />
                <button type="submit" class="btn btn-icon btn-sm" title="Retry deploying worker"
                  data-bs-toggle="tooltip">
                  <i class="ti ti-reload"></i>
                </button>
              </form>
              {% endif %}
            </div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
