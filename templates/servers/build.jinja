<div class="page-header d-print-none mb-3">
  <div class="row g-2 align-items-center">
    <div class="col">
      <div class="page-pretitle">Servers</div>
      <h2 class="page-title">Pick a server template</h2>
    </div>
  </div>
</div>

<div class="alert alert-info alert-dismissible mb-3" role="alert">
  <div class="d-flex">
    <div class="me-3"><i class="ti ti-info-circle icon alert-icon"></i></div>
    <div class="text-secondary">
      <strong>Note:</strong> only Ubuntu 20.04 and 22.04 are supported today. Debian and Ubuntu 23.04 are coming soon.
    </div>
  </div>
  <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
</div>

<div class="row row-cards">
  {% for s in serverTypes %}
  <div class="col-md-6 col-xl-4">
    <div class="card h-100">
      <div class="card-body">
        <div class="d-flex align-items-start mb-2">
          <h3 class="card-title flex-fill mb-0">{{s.Name}}</h3>
          <img src="/static/icons/{{s.Slug}}.svg" alt="{{s.Slug}}" style="max-width:56px" class="ms-3" />
        </div>
        <p class="text-secondary mb-0">{{s.Description}}</p>
      </div>
      <div class="card-footer text-end">
        <a href="/server/create/{{s.Slug}}" class="btn btn-primary">
          {% if s.Slug == "existing" %}
          <i class="ti ti-plug-connected me-2"></i>Connect
          {% else %}
          <i class="ti ti-rocket me-2"></i>Build
          {% endif %}
        </a>
      </div>
    </div>
  </div>
  {% endfor %}
</div>
