<div class="row justify-content-center">
  <div class="col-lg-7">
    <div class="card">
      <div class="card-body text-center py-5">
        <h3 class="mb-1">Testing SSH connection</h3>
        <div class="text-secondary mb-4 font-monospace">{{serverName}} ({{serverIP}})</div>

        {# Kept outside the swap target so it survives and can be reused by the
           "Try again" button in the failure fragment. #}
        <div id="sshtest-progress" class="htmx-indicator">
          <div class="progress progress-sm mb-4">
            <div class="progress-bar progress-bar-indeterminate"></div>
          </div>
          <p class="text-secondary">
            Scriptables is connecting with the SSH keys on this machine. Hang tight&hellip;
          </p>
        </div>

        {# Fires once on load. Success sends back HX-Redirect; failure swaps in
           an alert fragment with retry and edit actions. #}
        <div id="sshtest-result" hx-post="/server/test-ssh-ajax/{{id}}" hx-trigger="load" hx-swap="innerHTML"
          hx-indicator="#sshtest-progress"></div>
      </div>
    </div>
  </div>
</div>
