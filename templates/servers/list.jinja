<div class="page-header d-print-none mb-3">
  <div class="row g-2 align-items-center">
    <div class="col">
      <h2 class="page-title">Servers</h2>
      <div class="text-secondary mt-1">{{numServers}} server(s)</div>
    </div>
    <div class="col-auto ms-auto d-print-none">
      <div class="d-flex gap-2 align-items-center">
        <input type="hidden" name="view" value="{{view}}" />
        <div class="btn-group" role="group">
          <a href="/servers" class="btn btn-icon{% if view != "list" %} active{% endif %}" title="Grid view"
            data-bs-toggle="tooltip">
            <i class="ti ti-layout-grid"></i>
          </a>
          <a href="/servers?view=list" class="btn btn-icon{% if view == "list" %} active{% endif %}" title="List view"
            data-bs-toggle="tooltip">
            <i class="ti ti-list"></i>
          </a>
        </div>

        <select class="form-select w-auto" name="status" hx-get="/servers" hx-trigger="change"
          hx-target="#server-results" hx-select="#server-results" hx-swap="outerHTML" hx-push-url="true"
          hx-include="[name='view']">
          <option value="all" {% if status=="all" %}selected{% endif %}>All servers</option>
          <option value="{{STATUS_QUEUED}}" {% if status==STATUS_QUEUED %}selected{% endif %}>Queued builds</option>
          <option value="{{STATUS_RUNNING}}" {% if status==STATUS_RUNNING %}selected{% endif %}>Running builds</option>
          <option value="{{STATUS_COMPLETE}}" {% if status==STATUS_COMPLETE %}selected{% endif %}>Active servers</option>
          <option value="{{STATUS_FAILED}}" {% if status==STATUS_FAILED %}selected{% endif %}>Failed builds</option>
          <option value="{{STATUS_CONNECTING}}" {% if status==STATUS_CONNECTING %}selected{% endif %}>Testing SSH
            connection</option>
        </select>

        <a href="/" class="btn btn-primary">
          <i class="ti ti-plus me-2"></i>New server
        </a>
      </div>
    </div>
  </div>
</div>

<div id="server-results">
{% if numServers == 0 %}
<div class="card">
  <div class="empty">
    <div class="empty-icon">
      <i class="ti ti-server text-secondary" style="font-size:3rem"></i>
    </div>
    <p class="empty-title">No servers found</p>
    <p class="empty-subtitle text-secondary">
      Build your first server to start deploying sites.
    </p>
    <div class="empty-action">
      <a href="/" class="btn btn-primary">
        <i class="ti ti-plus me-2"></i>Build a server
      </a>
    </div>
  </div>
</div>
{% endif %}

{% if view == "list" and numServers > 0 %}
<div class="card">
  <div class="table-responsive">
    <table class="table table-vcenter card-table">
      <thead>
        <tr>
          <th>Server name</th>
          <th>Server IP</th>
          <th>Port</th>
          <th>SSH username</th>
          <th>Status</th>
          <th class="w-1">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for s in servers %}
        <tr>
          <td>{{s.ServerName}}</td>
          <td class="text-secondary">{{s.ServerIP}}</td>
          <td class="text-secondary">{{s.NewSshPort}}</td>
          <td class="text-secondary">{{s.NewSSHUsername}}</td>
          <td>
            {% if s.Status == STATUS_QUEUED %}
            <span class="badge bg-secondary-lt">Queued</span>
            {% endif %}
            {% if s.Status == STATUS_CONNECTING %}
            <span class="badge bg-azure-lt">Testing SSH</span>
            {% endif %}
            {% if s.Status == STATUS_COMPLETE %}
            <span class="badge bg-success-lt">Online</span>
            {% endif %}
            {% if s.Status == STATUS_RUNNING %}
            <span class="badge bg-blue-lt">Building</span>
            {% endif %}
            {% if s.Status == STATUS_FAILED %}
            <span class="badge bg-danger-lt">Failed</span>
            {% endif %}
          </td>
          <td>
            <div class="btn-list flex-nowrap">
              <a href="/logs/server/{{s.ID}}" class="btn btn-icon btn-sm" title="View log" data-bs-toggle="tooltip">
                <i class="ti ti-terminal-2"></i>
              </a>

              {% if s.Status == STATUS_COMPLETE %}
              <a href="/server/firewall/{{s.ID}}" class="btn btn-icon btn-sm" title="Manage firewall"
                data-bs-toggle="tooltip">
                <i class="ti ti-flame"></i>
              </a>
              {% endif %}

              {% if s.Status == STATUS_FAILED %}
              <form method="post" action="/server/retrybuild">
                <input type="hidden" name="_csrf_token" value="{{_csrf_token}}" />
                <input type="hidden" name="retryBuildServerId" value="{{s.ID}}" />
                <button type="submit" class="btn btn-icon btn-sm" title="Retry build" data-bs-toggle="tooltip">
                  <i class="ti ti-reload"></i>
                </button>
              </form>
              <a href="/server/update/{{s.ID}}" class="btn btn-icon btn-sm" title="Edit server"
                data-bs-toggle="tooltip">
                <i class="ti ti-edit"></i>
              </a>
              {% endif %}
            </div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

{% else %}

<div class="row row-cards">
  {% for s in servers %}
  <div class="col-md-6 col-xl-4">
    <div class="card h-100">
      <div class="card-body">
        <div class="d-flex align-items-start">
          <div class="flex-fill">
            <h3 class="card-title mb-1">{{s.ServerName}}</h3>
            <div class="text-secondary font-monospace small">
              {{s.NewSSHUsername}}@{{s.ServerIP}}:{{s.NewSshPort}}
            </div>
            <div class="mt-2">
              {% if s.Status == STATUS_QUEUED %}
              <span class="badge bg-secondary-lt">Build queued</span>
              {% endif %}
              {% if s.Status == STATUS_CONNECTING %}
              <span class="badge bg-azure-lt">Testing SSH connection</span>
              {% endif %}
              {% if s.Status == STATUS_COMPLETE %}
              <span class="badge bg-success-lt">Online</span>
              {% endif %}
              {% if s.Status == STATUS_RUNNING %}
              <span class="badge bg-blue-lt">Building</span>
              {% endif %}
              {% if s.Status == STATUS_FAILED %}
              <span class="badge bg-danger-lt">Build failed</span>
              {% endif %}
            </div>
          </div>
          <img src="/static/icons/{{s.ServerType}}.svg" alt="{{s.ServerType}}" style="max-width:64px" class="ms-3" />
        </div>
      </div>

      <div class="card-footer">
        <div class="btn-list">
          <a href="/logs/server/{{s.ID}}" class="btn btn-sm">
            <i class="ti ti-terminal-2 me-1"></i>Log
          </a>

          {% if s.Status == STATUS_COMPLETE %}
          <a href="/server/firewall/{{s.ID}}" class="btn btn-sm">
            <i class="ti ti-flame me-1"></i>Firewall
          </a>
          {% endif %}

          {% if s.Status == STATUS_FAILED %}
          <form method="post" action="/server/retrybuild">
            <input type="hidden" name="_csrf_token" value="{{_csrf_token}}" />
            <input type="hidden" name="retryBuildServerId" value="{{s.ID}}" />
            <button type="submit" class="btn btn-sm">
              <i class="ti ti-reload me-1"></i>Retry
            </button>
          </form>
          <a href="/server/update/{{s.ID}}" class="btn btn-sm">
            <i class="ti ti-edit me-1"></i>Edit
          </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
  {% endfor %}
</div>
{% endif %}

</div>
