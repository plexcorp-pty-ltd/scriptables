# Scriptables configuration template. Copy to .env and edit.
# Real environment variables override anything set here.

# --- Database -------------------------------------------------------------
# Local MariaDB. The schema lives in build/docker-entrypoint-initdb.d/ and
# migrations in build/migrations/.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=scriptables
MYSQL_USER=scriptable
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# --- Cache / sessions -----------------------------------------------------
REDIS_DSN=127.0.0.1:6379

# --- Web server -----------------------------------------------------------
SCRIPTABLES_SERVER_DSN_HOST=127.0.0.1
SCRIPTABLES_SERVER_DSN_PORT=3001
# Used to build absolute links in emails and deploy webhooks.
SCRIPTABLE_URL=http://127.0.0.1:3001
# Comma separated proxies to trust for client IPs. Empty means trust none,
# which is correct when nothing sits in front of Scriptables.
ALLOWED_IPS=

# --- Security -------------------------------------------------------------
# AES key: must be exactly 16, 24 or 32 characters. Keep it alphanumeric - this
# file is also read by docker compose, whose parser handles quoting differently.
# Changing it makes every already encrypted value (MySQL passwords, logs, 2FA
# secrets) unreadable.
ENCRYPTION_KEY=CHANGE-ME-16-24-OR-32-CHARS-LONG
# Set to false once your admin account exists to close public registration.
ALLOW_REGISTER=true

# --- SSH ------------------------------------------------------------------
# Scriptables uses the keys already on this machine. Uncomment to point
# somewhere other than ~/.ssh, or to narrow which keys are offered (most SSH
# servers allow only 6 authentication attempts).
# SCRIPTABLES_SSH_DIR=/home/youruser/.ssh
# SCRIPTABLES_SSH_KEYS=id_ed25519,id_rsa

# --- Mail -----------------------------------------------------------------
# Leave SMTP_USERNAME as xxxx to disable outbound email entirely.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=586
SMTP_USERNAME=xxxx
SMTP_PASSWORD=xxxx
SMTP_FROM_EMAIL=Scriptables <noreply@test.com>

# --- Runtime --------------------------------------------------------------
TZ=Africa/Johannesburg
VERBOSE_LOG=yes
GIN_MODE=release
